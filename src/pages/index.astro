---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import StoryCycle from '../components/sections/StoryCycle.astro';
import RouteCards from '../components/sections/RouteCards.astro';
import Firro from '../components/sections/Firro.astro';
import NativeNights from '../components/sections/NativeNights.astro';
import Services from '../components/sections/Services.astro';
import Work from '../components/sections/Work.astro';
import Insights from '../components/sections/Insights.astro';
import Process from '../components/sections/Process.astro';
import Founder from '../components/sections/Founder.astro';
import InvestorBand from '../components/sections/InvestorBand.astro';
import ContactCTA from '../components/sections/ContactCTA.astro';
---

<BaseLayout canonicalPath="/">
  <Hero />

  <!-- Light sheet: rises over the dark hero with radius-2xl top corners. -->
  <div class="sheet theme-light">
    <StoryCycle />
    <RouteCards />
    <Firro />
    <NativeNights />
    <Services />
    <Work />
    <Insights />
    <Process />
    <Founder />
  </div>

  <InvestorBand />
  <ContactCTA />
</BaseLayout>

<style>
  .sheet {
    position: relative;
    z-index: 1;
    padding-top: var(--hero-overlap);
    border-radius: var(--radius-2xl) var(--radius-2xl) 0 0;
    background-color: var(--surface-100);
  }

  @media (max-width: 767px) {
    .sheet {
      border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    }
  }
</style>
