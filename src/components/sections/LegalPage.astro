---
// Light, readable 720px column for Privacy / Terms, rendered from content/*.md.
// Shows a "Draft — pending legal review" banner while the frontmatter says draft: true.
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import Label from '../ui/Label.astro';
import Icon from '../ui/Icon.astro';
import { company, addressLine } from '../../data/company';

interface Props {
  title: string;
  draft: boolean;
  lastUpdated: string | Date;
  Content: AstroComponentFactory;
}

const { title, draft, lastUpdated, Content } = Astro.props;
const date = new Date(lastUpdated);
const dateLabel = date.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<div class="legal theme-light">
  <article class="container column">
    {
      draft && (
        <p class="draft t-small" role="note">
          <Icon name="alert" size={18} />
          Draft — pending legal review
        </p>
      )
    }
    <header class="head">
      <Label>Legal</Label>
      <h1 class="t-display-lg">{title}</h1>
      <p class="t-small muted">Last updated <time datetime={date.toISOString().slice(0, 10)}>{dateLabel}</time></p>
    </header>
    <div class="prose t-body">
      <Content />
    </div>
    <footer class="company t-small">
      <p><strong>{company.legalName}</strong> · CIN {company.cin} · {company.udyam}</p>
      <p>{addressLine}</p>
      <p><a href={`mailto:${company.email}`}>{company.email}</a></p>
    </footer>
  </article>
</div>

<style>
  .legal {
    padding-block: var(--section-pad);
    border-radius: var(--radius-2xl) var(--radius-2xl) 0 0;
  }
  .column {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    max-width: calc(720px + 2 * var(--gutter));
  }
  .draft {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    align-self: flex-start;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--amber);
    background: var(--surface-300);
    color: var(--ink);
  }
  .draft :global(svg) {
    color: var(--amber);
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .muted {
    color: var(--ink-muted);
  }
  .prose {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    color: var(--ink);
  }
  .prose :global(h2) {
    margin-top: var(--space-6);
    font-family: var(--font-display);
    font-size: var(--fs-heading);
    line-height: var(--lh-heading);
    font-weight: 500;
    letter-spacing: -0.015em;
  }
  .prose :global(ul) {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding-left: var(--space-6);
  }
  .prose :global(a),
  .company a {
    color: var(--pulse-text);
  }
  .company {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
    color: var(--ink-muted);
  }
  @media (max-width: 767px) {
    .legal {
      border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    }
  }
</style>
