---
// One primary style everywhere; secondary is a line-strong outline; text is an arrow link.
import Icon from './Icon.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'text';
  arrow?: boolean;
  glow?: boolean;
  intent?: string;
  external?: boolean;
  class?: string;
  [key: `data-${string}`]: string | undefined;
}

const {
  href,
  variant = 'primary',
  arrow = false,
  glow = false,
  intent,
  external = false,
  class: className,
  ...rest
} = Astro.props;
---

<a
  href={href}
  class:list={['btn', `btn--${variant}`, { 'btn--glow': glow }, 't-button', className]}
  data-intent={intent}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  {...rest}
>
  <slot />
  {arrow && <Icon name="arrow-right" size={18} stroke={2} />}
</a>

<style>
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 48px;
    padding: 0 var(--space-6);
    border-radius: var(--radius-md);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease;
  }

  .btn--primary {
    overflow: hidden;
    isolation: isolate;
    background: var(--pulse);
    color: var(--on-pulse);
  }

  .btn--primary:focus-visible {
    outline-color: var(--focus-on-pulse);
  }

  /* Sheen: sweeps once on hover; loops only on the hero's glowing button. */
  .btn--primary::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(110deg, transparent 30%, var(--sheen) 50%, transparent 70%);
    transform: translateX(-120%);
    pointer-events: none;
  }

  .btn--primary:hover::after {
    transition: transform 700ms ease;
    transform: translateX(120%);
  }

  .btn--glow {
    box-shadow: var(--shadow-glow);
  }

  .btn--glow::after {
    animation: sheen 4.5s ease-in-out 2s infinite;
  }

  .btn--secondary {
    border: 1px solid var(--line-strong);
    color: var(--ink);
    background: transparent;
  }

  .btn--secondary:hover {
    background: var(--surface-300);
  }

  .btn--text {
    padding: 0;
    color: var(--ink-muted);
  }

  .btn--text:hover {
    color: var(--ink);
  }

  @keyframes sheen {
    0%,
    70% {
      transform: translateX(-120%);
    }
    100% {
      transform: translateX(120%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn--primary::after {
      display: none;
    }
  }
</style>
