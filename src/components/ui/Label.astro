---
// Mono uppercase label (the brand's "machine voice"), always in ink; optional live dot.
import LiveDot from './LiveDot.astro';

interface Props {
  dot?: boolean;
  as?: 'div' | 'span' | 'p';
  class?: string;
}

const { dot = false, as: Tag = 'div', class: className } = Astro.props;
---

<Tag class:list={['label t-label', className]}>
  {dot && <LiveDot />}
  <slot />
</Tag>

<style>
  .label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--ink);
  }
</style>
