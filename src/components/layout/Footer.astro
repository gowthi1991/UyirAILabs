---
import Pill from '../ui/Pill.astro';
import { company, addressLine, mailto, whatsappUrl, NATIVE_NIGHTS_URL } from '../../data/company';

type FooterLink = { label: string; href: string; external?: boolean };

const columns: { title: string; links: FooterLink[] }[] = [
  {
    title: 'Company',
    links: [
      { label: 'About', href: '/#about' },
      { label: 'Investors', href: '/#investors' },
      { label: 'Contact', href: '/#contact' },
    ],
  },
  {
    title: 'Products',
    links: [
      { label: 'Firro', href: '/#firro' },
      NATIVE_NIGHTS_URL
        ? { label: 'Native Nights', href: NATIVE_NIGHTS_URL, external: true }
        : { label: 'Native Nights', href: '/#native-nights' },
    ],
  },
  {
    title: 'Services',
    links: [
      { label: 'AI and automation', href: '/#services' },
      { label: 'Web and mobile apps', href: '/#services' },
      { label: 'SaaS engineering', href: '/#services' },
      { label: 'UI/UX design', href: '/#services' },
    ],
  },
  {
    title: 'Contact',
    links: [
      { label: company.email, href: mailto },
      ...(whatsappUrl ? [{ label: 'WhatsApp', href: whatsappUrl, external: true }] : []),
      ...(company.linkedinUrl ? [{ label: 'LinkedIn', href: company.linkedinUrl, external: true }] : []),
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="grid">
      <div class="brand-col">
        <img src="/brand/uyir-lockup-dark.svg" alt="Uyir AI — Build Fast Build Right" width="240" height="82" loading="lazy" />
        <div class="pills">
          {company.dpiitRecognised && <Pill tone="pulse">DPIIT recognised</Pill>}
          <Pill tone="graphite">Udyam MSME</Pill>
        </div>
      </div>

      {
        columns.map((col) => (
          <nav class="col" aria-label={col.title}>
            <p class="t-label col-title">{col.title}</p>
            <ul role="list">
              {col.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    class="footer-link"
                    target={l.external ? '_blank' : undefined}
                    rel={l.external ? 'noopener' : undefined}
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="legal t-small">
      <p class="legal-text">
        {company.legalName} · CIN {company.cin} · {company.udyam}
        {company.gstin && <> · GSTIN {company.gstin}</>}
        <br />
        {addressLine}
      </p>
      <div class="legal-links">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <span>© {year}</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-16) var(--space-12);
    background: var(--surface-100);
    border-top: 1px solid var(--line);
  }

  .grid {
    display: grid;
    grid-template-columns: 2fr repeat(4, minmax(0, 1fr));
    gap: var(--space-8);
  }

  .brand-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .brand-col img {
    width: 240px;
    height: auto;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .col ul {
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    color: var(--ink);
    font-size: var(--fs-button);
    line-height: var(--lh-button);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .footer-link:hover {
    color: var(--pulse-text);
  }

  .legal {
    display: flex;
    justify-content: space-between;
    gap: var(--space-8);
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
    color: var(--ink-muted);
  }

  .legal-links {
    display: flex;
    align-items: flex-start;
    gap: var(--space-6);
  }

  .legal-links a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--ink-muted);
    text-decoration: none;
  }

  .legal-links a:hover {
    color: var(--ink);
  }

  @media (max-width: 1023px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .brand-col {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 767px) {
    .site-footer {
      padding-block: var(--space-16) var(--space-12);
    }

    .legal {
      flex-direction: column;
      gap: var(--space-4);
    }

    .footer-link {
      min-height: 44px;
    }

    .legal-links a {
      min-height: 44px;
    }
  }
</style>
